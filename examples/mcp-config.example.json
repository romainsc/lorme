{
  "mcpServers": {
    "lore": {
      "command": "lorme",
      "args": ["serve", "--config", "/path/to/config.yaml"]
    },
    "lore-container": {
      "command": "podman",
      "args": [
        "run", "-i", "--rm",
        "-v", "/path/to/data:/data:Z",
        "lorme", "serve",
        "--config", "/data/config.yaml"
      ]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp"
    }
  }
}
